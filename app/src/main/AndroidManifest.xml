<?xml version="1.0" encoding="utf-8"?>
<!-- Sin permiso INTERNET: la app no puede enviar nada fuera del móvil. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Para leer la ubicación GPS guardada en las fotos (Android 10+) -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- Opcional (Android 12+): mover/editar fotos sin confirmar cada vez; lo concede el usuario en Ajustes -->
    <uses-permission android:name="android.permission.MANAGE_MEDIA" tools:ignore="ProtectedPermissions" />

    <!-- Las librerías de ML Kit piden Internet para estadísticas: se elimina a la fuerza -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:label="Fotos Duplicadas"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="false"
        android:theme="@style/AppTheme">
        <!-- Pantalla de entrada: calculadora. El código secreto abre la app. -->
        <activity
            android:name=".CalculatorActivity"
            android:exported="true"
            android:excludeFromRecents="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <!-- Dos accesos en el lanzador; solo uno activo (se cambia desde Ajustes) -->
        <activity-alias
            android:name=".LauncherPhotos"
            android:targetActivity=".CalculatorActivity"
            android:label="Fotos Duplicadas"
            android:icon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherCalc"
            android:targetActivity=".CalculatorActivity"
            android:label="Calculadora"
            android:icon="@mipmap/ic_calc"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
    </application>
</manifest>
